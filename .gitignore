node_modules/

# --- generated, scratch or machine-local: never commit (added 2026-10-05) ---
.claude/worktrees/
eval/priors/
eval/raw*/
eval/cache/
experiments/**/results*.jsonl
experiments/**/*.log
experiments/**/sim-*.txt
*.log
.DS_Store
# eval harness output: copies of the app and generated results (the scripts and README are kept)
eval/.app/
eval/.app-*/
eval/cases.json
eval/controls-results.json
eval/results.json

# extension build output (scripts/build-extension.mjs)
dist/

# generated experiment outputs — regenerated by the scripts beside them; never commit
experiments/**/report.html
experiments/**/report-data.json
experiments/context-growth/simulation*.json
experiments/context-growth/real-sessions.json

# snips study: fetched web pages, their text, the app copy it imports from, and run logs (scripts, asks, results stay)
eval/snips/cache/
eval/snips/data/pages/
eval/snips/app
eval/snips/*.log
eval/controls-results*.json

