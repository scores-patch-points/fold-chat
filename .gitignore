# --- added 2026-10-05 (round 2): scratch / iteration snapshots / derived outputs; each is regenerated by the script named ---
# python virtualenvs and bytecode (scripts/pii/.venv is ~560 MB; pip install regenerates it). The venv's own .gitignore already hides it; this is belt and braces
.venv/
__pycache__/
# controls.mjs --out iteration snapshots v1..v11 (~0.8 MB, ~28k lines). controls-final.json and controls-baseline-live.json are NOT ignored: docs/GATE-FIX-PREREG.md cites the baseline
/eval/controls-v[0-9]*.json
# rescore-labels.mjs --gate baseline|live outputs (~200 KB, ~6.5k lines); rerun the script (offline) to regenerate
/eval/rescore-*.json
# run-all-cur.sh second-run scoring output (eval/README.md lists it as an output, like the already-ignored eval/results.json)
/eval/results-cur2.json
# gary-flow measure.mjs per-arm run output (~400 KB, ~10k lines); RESULTS.md and PREREG.md hold the findings. passages.json (sha256 frozen in PREREG) and turn1.json are kept
/eval/gary-flow/results.json
# snips study: model-path run outputs (gemma2:2b, model-run.mjs -> data/model/*.json), sibling of the already-ignored data/out and data/pages
/eval/snips/data/model/
# snips study: analyze.mjs derived stats (analysis.md, the readable report, is kept)
/eval/snips/stats.json
# stale scratch copy of fold-chat-ground.js with absolute import paths (52 KB); the real module is fold-chat-ground.js
/ground-dbg.mjs

# generated/measurement output that was swept into the 431c1ce WIP roundup (each is reproduced by its script; files stay on disk)
/eval/results-cur.json
/eval/snips/judged.json
/eval/snips/gold-verify.json
/eval/snips/asks.json
/experiments/*/out/
/experiments/*/vendor/
