{
  "name": "fold-chat",
  "private": true,
  "type": "module",
  "description": "The Fold's chat version — a browser surface over the heimdall bridge. No build step; index.html is the app.",
  "scripts": {
    "serve": "node server.mjs",
    "test": "node --test",
    "e2e": "node fold-e2e-falsify.mjs",
    "e2e:essay": "node fold-e2e-essay.mjs --mouth compose",
    "e2e:essay:ollama": "node fold-e2e-essay.mjs --mouth ollama",
    "e2e:experiment": "node fold-experiment.mjs --tasks 6 --voice none"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
